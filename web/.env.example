# API Backend Base URL (Proxied via Vite or Direct URL)
VITE_API_BASE=/api

# Use Mock Data for Offline Testing
VITE_USE_MOCK=false

# Optional: Enable User Authentication (Default: false for open-source guest mode)
VITE_ENABLE_AUTH=false

# Static Assets Base URL (Optional, defaults to relative)
VITE_CITY_ASSET_BASE_URL=
