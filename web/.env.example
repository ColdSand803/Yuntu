# API Backend Base URL (Proxied via Vite or Direct URL)
VITE_API_BASE=/api

# Use Mock Data for Offline Testing
VITE_USE_MOCK=false

# Static Assets Base URL (Optional, defaults to relative)
VITE_CITY_ASSET_BASE_URL=

# 高德地图前端交互可视化 (Web端 JS API)
# 注意：此 Key 必须是高德控制台中平台为「Web端 (JS API)」的 Key，不可使用后端的「Web服务」Key
VITE_AMAP_KEY=
# 高德自 2021 年起强制要求的安全密钥 securityJsCode
VITE_AMAP_SECURITY=
