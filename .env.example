# ==============================================================================
# Yuntu Travel Planning Engine - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://yuntu:yuntupassword@localhost:5432/yuntu_travel

# ------------------------------------------------------------------------------
# Network Proxy (Optional - for restricted network / VPN environments)
# ------------------------------------------------------------------------------
# Proxy for database connection (supports socks5://127.0.0.1:7890 or http://127.0.0.1:7890)
# Leave empty to connect to the database directly.
DATABASE_PROXY=

# Proxy for outbound LLM API requests (supports http://127.0.0.1:7890 or socks5://127.0.0.1:7890)
# Leave empty to connect to LLM APIs directly.
LLM_PROXY=

# ------------------------------------------------------------------------------
# LLM Providers Configuration (Intent Parser / Final Writer / Review Gate)
# ------------------------------------------------------------------------------
# You can use Gemini, DeepSeek, or any OpenAI-compatible provider (OpenAI, OneAPI, NewAPI, Ollama, etc.)

# Option A: Google Gemini / NewAPI / OneAPI (OpenAI-compatible Relay)
GEMINI_API_KEY=your_api_key_here
# If using a proxy or NewAPI relay station, set the base URL ending with /v1 (e.g. https://api.your-newapi.com/v1)
# If empty, defaults to official Google endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_BASE_URL=

# Option B: DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=

# Option C: OpenAI / Standard OpenAI-compatible Relay
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Per-Role LLM Configuration (Default setup)
INTENT_PROVIDER=gemini
INTENT_MODEL=gemini-2.5-flash
INTENT_API_KEY=

WRITER_PROVIDER=gemini
WRITER_MODEL=gemini-2.5-pro
WRITER_API_KEY=

REVIEW_PROVIDER=gemini
REVIEW_MODEL=gemini-2.5-flash
REVIEW_API_KEY=

GROUPING_PROVIDER=gemini
GROUPING_MODEL=gemini-2.5-flash
GROUPING_API_KEY=

SELECTOR_PROVIDER=gemini
SELECTOR_MODEL=gemini-2.5-flash
SELECTOR_API_KEY=

EXTRACT_PROVIDER=gemini
EXTRACT_MODEL=gemini-2.5-flash
EXTRACT_API_KEY=

# ------------------------------------------------------------------------------
# Map & Geo Services (AMap / 高德开放平台)
# ------------------------------------------------------------------------------
# Required for Geocoding & Route Commute Distance Optimization
AMAP_API_KEY=your_amap_web_api_key_here
# Optional second key for POI search; falls back to AMAP_API_KEY
AMAP_API_KEY_TWO=
AMAP_ROUTE_ENABLED=true

# Xiaohongshu crawl via TikHub (optional; not required for Amap city seeding)
TIKHUB_API_TOKEN=
TIKHUB_BASE_URL=https://api.tikhub.io

# ------------------------------------------------------------------------------
# Background Workers & Task Concurrency
# ------------------------------------------------------------------------------
TRIP_WORKER_ENABLED=true
TRIP_WORKER_CONCURRENCY=3
TRIP_JOB_TIMEOUT_SECONDS=180
